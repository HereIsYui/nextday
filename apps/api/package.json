{
  "name": "@nextday/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "predev": "npm run build:packages --prefix ../..",
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://nextday:nextday@localhost:5432/nextday_game} tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:m1": "DATABASE_URL=postgresql://nextday:nextday@localhost:5432/nextday_game vitest run test/m1.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nextday/shared": "0.0.0",
    "@prisma/client": "^6.19.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
