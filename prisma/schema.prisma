generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  accountId    String    @id @map("account_id")
  accountType  String    @map("account_type")
  deviceId     String?   @unique @map("device_id")
  fishpiUserId String?   @unique @map("fishpi_user_id")
  username     String?
  status       String    @default("normal")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  player       Player?
  auditLogs    AuditLog[]
  loginLogs    LoginLog[]
  behaviorLogs BehaviorLog[]
  riskRecords  BehaviorRiskRecord[]
  idempotency  IdempotencyRecord[]

  @@index([accountType])
  @@index([status])
  @@map("account")
}

model Player {
  playerId     String   @id @map("player_id")
  accountId    String   @unique @map("account_id")
  name         String   @unique
  route        String
  alignment    String   @default("undecided")
  currentRealm Int      @default(1) @map("current_realm")
  currentStage Int      @default(1) @map("current_stage")
  currentLevel Int      @default(1) @map("current_level")
  sectId       String?  @map("sect_id")
  status       String   @default("normal")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account                   Account                    @relation(fields: [accountId], references: [accountId])
  progress                  PlayerProgress?
  wallet                    PlayerWallet?
  actionState               PlayerActionState?
  caveState                 PlayerCaveState?
  innerWorldState           InnerWorldState?
  innerWorldCreatures       InnerWorldCreature[]
  innerWorldAssignments     InnerWorldAssignment[]
  innerWorldLawRecords      InnerWorldLawRecord[]
  innerWorldSupportRecords  InnerWorldSupportRecord[]
  items                     PlayerItem[]
  walletLogs                WalletLog[]
  auditLogs                 AuditLog[]
  behaviorLogs              BehaviorLog[]
  loginLogs                 LoginLog[]
  provinces                 PlayerProvinceProgress[]
  tasks                     PlayerTaskState[]
  battleLogs                BattleLog[]
  caveRecords               CaveCollectRecord[]
  alchemyRecords            AlchemyRecord[]
  pillUseRecords            PillUseRecord[]
  equipmentInstances        EquipmentInstance[]
  equipmentOperationRecords EquipmentOperationRecord[]
  skillLoadout              PlayerSkillLoadout?
  sectMembership            SectMember?
  towerActionRecords        TowerActionRecord[]
  bossChallengeRecords      WorldBossChallengeRecord[]
  pvpAttacks                PvpBattleRecord[]          @relation("PvpAttacker")
  pvpDefenses               PvpBattleRecord[]          @relation("PvpDefender")
  sectTaskRecords           SectTaskRecord[]
  purchaseOrders            PurchaseOrder[]
  monthlyCards              MonthlyCardState[]
  monthlyDrawGrants         MonthlyCardDrawGrant[]
  vipState                  PlayerVipState?
  gachaRecords              GachaRecord[]
  gachaPityStates           GachaPityState[]
  ancientTreasures          AncientTreasureState[]
  convenienceStrategies     ConvenienceStrategy[]
  automationQueues          AutomationQueue[]
  appearances               PlayerAppearance[]
  riskRecords               BehaviorRiskRecord[]
  delayedSettlements        DelayedSettlementRecord[]
  mails                     PlayerMail[]

  @@index([accountId])
  @@index([sectId])
  @@index([currentRealm, currentStage, currentLevel])
  @@index([status])
  @@map("player")
}

model PlayerProgress {
  playerId               String    @id @map("player_id")
  eraId                  String    @default("era_mvp_001") @map("era_id")
  cultivationValue       BigInt    @default(0) @map("cultivation_value")
  breakthroughFailCount  Int       @default(0) @map("breakthrough_fail_count")
  calamityValue          Int       @default(0) @map("calamity_value")
  chapterId              Int       @default(1) @map("chapter_id")
  catchupBonusRate       Int       @default(0) @map("catchup_bonus_rate")
  newbieProtectionUntil  DateTime? @map("newbie_protection_until")
  dailyActiveScore       Int       @default(0) @map("daily_active_score")
  weeklyActiveScore      Int       @default(0) @map("weekly_active_score")
  cultivationRatePerHour Int       @default(240) @map("cultivation_rate_per_hour")
  lastCultivationAt      DateTime  @default(now()) @map("last_cultivation_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([eraId])
  @@index([chapterId])
  @@map("player_progress")
}

model PlayerWallet {
  playerId      String   @id @map("player_id")
  spiritStone   BigInt   @default(0) @map("spirit_stone")
  immortalStone BigInt   @default(0) @map("immortal_stone")
  jadePaid      BigInt   @default(0) @map("jade_paid")
  jadeBound     BigInt   @default(0) @map("jade_bound")
  eraPoint      BigInt   @default(0) @map("era_point")
  updatedAt     DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@map("player_wallet")
}

model PlayerItem {
  itemInstanceId String    @id @map("item_instance_id")
  playerId       String    @map("player_id")
  itemId         String    @map("item_id")
  count          BigInt
  bindType       String    @map("bind_type")
  locked         Boolean   @default(false)
  sourceType     String    @map("source_type")
  metadata       Json?
  expireAt       DateTime? @map("expire_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([itemId])
  @@index([bindType])
  @@index([sourceType])
  @@index([expireAt])
  @@map("player_item")
}

model PlayerActionState {
  playerId                  String   @id @map("player_id")
  eraId                     String   @default("era_mvp_001") @map("era_id")
  actionPoints              Int      @default(60) @map("action_points")
  actionPointCap            Int      @default(180) @map("action_point_cap")
  actionPointRestorePerHour Int      @default(12) @map("action_point_restore_per_hour")
  lastRecoveredAt           DateTime @default(now()) @map("last_recovered_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([eraId])
  @@map("player_action_state")
}

model ProvinceState {
  provinceStateId String   @id @map("province_state_id")
  eraId           String   @default("era_mvp_001") @map("era_id")
  provinceId      String   @map("province_id")
  name            String
  towerName       String   @map("tower_name")
  chapterRequired Int      @default(1) @map("chapter_required")
  unlocked        Boolean  @default(true)
  towerIntegrity  Int      @default(1000) @map("tower_integrity")
  riftPressure    Int      @default(0) @map("rift_pressure")
  corruption      Int      @default(0)
  spiritVeinLevel Int      @default(1) @map("spirit_vein_level")
  factionControl  Json     @map("faction_control")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([eraId, provinceId])
  @@index([eraId])
  @@index([provinceId])
  @@map("province_state")
}

model PlayerProvinceProgress {
  provinceProgressId String    @id @map("province_progress_id")
  playerId           String    @map("player_id")
  eraId              String    @default("era_mvp_001") @map("era_id")
  provinceId         String    @map("province_id")
  unlocked           Boolean   @default(false)
  bestExploreStage   Int       @default(0) @map("best_explore_stage")
  explorationCount   Int       @default(0) @map("exploration_count")
  lastActionAt       DateTime? @map("last_action_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@unique([playerId, provinceId])
  @@index([playerId])
  @@index([eraId, provinceId])
  @@map("player_province_progress")
}

model BattleLog {
  battleId       String   @id @map("battle_id")
  playerId       String   @map("player_id")
  eraId          String   @default("era_mvp_001") @map("era_id")
  battleType     String   @map("battle_type")
  provinceId     String?  @map("province_id")
  enemyId        String   @map("enemy_id")
  enemyName      String   @map("enemy_name")
  result         String
  rounds         Int
  damageDone     Int      @map("damage_done")
  damageTaken    Int      @map("damage_taken")
  rewardSnapshot Json     @map("reward_snapshot")
  battleLog      Json     @map("battle_log")
  createdAt      DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([eraId])
  @@index([battleType])
  @@index([provinceId])
  @@index([createdAt])
  @@map("battle_log")
}

model PlayerTaskState {
  taskStateId    String   @id @map("task_state_id")
  playerId       String   @map("player_id")
  taskId         String   @map("task_id")
  taskType       String   @map("task_type")
  title          String
  targetValue    Int      @map("target_value")
  progressValue  Int      @default(0) @map("progress_value")
  status         String   @default("in_progress")
  resetKey       String   @default("permanent") @map("reset_key")
  rewardSnapshot Json     @map("reward_snapshot")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@unique([playerId, taskId, resetKey])
  @@index([playerId])
  @@index([taskType, status])
  @@map("player_task_state")
}

model PlayerCaveState {
  playerId          String   @id @map("player_id")
  spiritFieldLevel  Int      @default(1) @map("spirit_field_level")
  spiritArrayLevel  Int      @default(1) @map("spirit_array_level")
  alchemyRoomLevel  Int      @default(1) @map("alchemy_room_level")
  refineryRoomLevel Int      @default(1) @map("refinery_room_level")
  lastCollectedAt   DateTime @default(now()) @map("last_collected_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@map("player_cave_state")
}

model CaveCollectRecord {
  recordId         String   @id @map("record_id")
  playerId         String   @map("player_id")
  spiritStone      BigInt   @map("spirit_stone")
  herbCount        Int      @map("herb_count")
  oreCount         Int      @map("ore_count")
  collectedMinutes Int      @map("collected_minutes")
  rewardSnapshot   Json     @map("reward_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([createdAt])
  @@map("cave_collect_record")
}

model InnerWorldState {
  playerId           String   @id @map("player_id")
  eraId              String   @default("era_mvp_001") @map("era_id")
  worldLevel         Int      @default(1) @map("world_level")
  lawLevel           Int      @default(1) @map("law_level")
  lawExp             Int      @default(0) @map("law_exp")
  creatureCapacity   Int      @default(3) @map("creature_capacity")
  assignmentLimit    Int      @default(1) @map("assignment_limit")
  supportCountToday  Int      @default(0) @map("support_count_today")
  supportResetKey    String   @default("1970-01-01") @map("support_reset_key")
  configVersion      String   @map("config_version")
  rewardConfigVersion String  @map("reward_config_version")
  updatedAt          DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([eraId])
  @@index([worldLevel])
  @@map("inner_world_state")
}

model InnerWorldCreature {
  creatureId             String   @id @map("creature_id")
  playerId               String   @map("player_id")
  eraId                  String   @default("era_mvp_001") @map("era_id")
  creatureType           String   @map("creature_type")
  name                   String
  level                  Int      @default(1)
  affinityProvinceId     String?  @map("affinity_province_id")
  assignmentBonusSummary Json     @map("assignment_bonus_summary")
  status                 String   @default("idle")
  configVersion          String   @map("config_version")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  player      Player                 @relation(fields: [playerId], references: [playerId])
  assignments InnerWorldAssignment[]

  @@index([playerId])
  @@index([eraId])
  @@index([status])
  @@index([affinityProvinceId])
  @@map("inner_world_creature")
}

model InnerWorldAssignment {
  assignmentId       String    @id @map("assignment_id")
  playerId           String    @map("player_id")
  eraId              String    @default("era_mvp_001") @map("era_id")
  creatureId         String    @map("creature_id")
  provinceId         String    @map("province_id")
  status             String    @default("active")
  startedAt          DateTime  @default(now()) @map("started_at")
  endsAt             DateTime  @map("ends_at")
  claimedAt          DateTime? @map("claimed_at")
  rewardSnapshot     Json      @map("reward_snapshot")
  lawExpGain         Int       @default(0) @map("law_exp_gain")
  configVersion      String    @map("config_version")
  rewardConfigVersion String   @map("reward_config_version")
  idempotencyKey     String?   @unique @map("idempotency_key")

  player   Player             @relation(fields: [playerId], references: [playerId])
  creature InnerWorldCreature @relation(fields: [creatureId], references: [creatureId])

  @@index([playerId])
  @@index([eraId])
  @@index([provinceId])
  @@index([status])
  @@index([endsAt])
  @@map("inner_world_assignment")
}

model InnerWorldLawRecord {
  lawRecordId   String   @id @map("law_record_id")
  playerId      String   @map("player_id")
  eraId         String   @default("era_mvp_001") @map("era_id")
  lawType       String   @map("law_type")
  expDelta      Int      @map("exp_delta")
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  beforeLevel   Int      @map("before_level")
  afterLevel    Int      @map("after_level")
  beforeExp     Int      @default(0) @map("before_exp")
  afterExp      Int      @default(0) @map("after_exp")
  configVersion String   @map("config_version")
  createdAt     DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([eraId])
  @@index([lawType])
  @@index([sourceType])
  @@index([createdAt])
  @@map("inner_world_law_record")
}

model InnerWorldSupportRecord {
  supportRecordId      String   @id @map("support_record_id")
  playerId             String   @map("player_id")
  eraId                String   @default("era_mvp_001") @map("era_id")
  provinceId           String   @map("province_id")
  towerId              String?  @map("tower_id")
  supportType          String   @map("support_type")
  costSummary          Json     @map("cost_summary")
  rewardSummary        Json     @map("reward_summary")
  contributionSummary  Json     @map("contribution_summary")
  idempotencyKey       String?  @unique @map("idempotency_key")
  configVersion        String   @map("config_version")
  rewardConfigVersion  String   @map("reward_config_version")
  createdAt            DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([eraId])
  @@index([provinceId])
  @@index([supportType])
  @@index([createdAt])
  @@map("inner_world_support_record")
}

model AlchemyRecord {
  recordId              String   @id @map("record_id")
  playerId              String   @map("player_id")
  eraId                 String   @default("era_mvp_001") @map("era_id")
  recipeId              String   @map("recipe_id")
  pillItemId            String?  @map("pill_item_id")
  quality               String?
  success               Boolean
  count                 Int      @default(1)
  materialSnapshot      Json     @map("material_snapshot")
  failureReturnSnapshot Json?    @map("failure_return_snapshot")
  resultSnapshot        Json     @map("result_snapshot")
  configVersion         String   @map("config_version")
  rewardConfigVersion   String   @map("reward_config_version")
  idempotencyKey        String?  @unique @map("idempotency_key")
  createdAt             DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([eraId])
  @@index([recipeId])
  @@index([pillItemId])
  @@index([createdAt])
  @@map("alchemy_record")
}

model PillUseRecord {
  recordId          String   @id @map("record_id")
  playerId          String   @map("player_id")
  eraId             String   @default("era_mvp_001") @map("era_id")
  pillItemId        String   @map("pill_item_id")
  pillRank          Int      @map("pill_rank")
  pillType          String   @map("pill_type")
  route             String
  quality           String
  sameTierUseCount  Int      @map("same_tier_use_count")
  effectiveRate     Int      @map("effective_rate")
  effectValue       Int      @map("effect_value")
  beforeCultivation BigInt   @map("before_cultivation")
  afterCultivation  BigInt   @map("after_cultivation")
  configVersion     String   @map("config_version")
  idempotencyKey    String?  @unique @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([eraId])
  @@index([pillItemId])
  @@index([pillType, pillRank])
  @@index([createdAt])
  @@map("pill_use_record")
}

model EquipmentInstance {
  equipmentInstanceId String   @id @map("equipment_instance_id")
  playerId            String   @map("player_id")
  eraId               String   @default("era_mvp_001") @map("era_id")
  equipmentId         String   @map("equipment_id")
  name                String
  equipmentType       String   @map("equipment_type")
  rarity              String
  starLevel           Int      @default(0) @map("star_level")
  bindType            String   @map("bind_type")
  locked              Boolean  @default(false)
  equippedSlot        String?  @map("equipped_slot")
  durability          Int      @default(100)
  maxDurability       Int      @default(100) @map("max_durability")
  sourceType          String   @map("source_type")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  player     Player                     @relation(fields: [playerId], references: [playerId])
  affixes    EquipmentAffix[]
  operations EquipmentOperationRecord[]

  @@index([playerId])
  @@index([eraId])
  @@index([equipmentId])
  @@index([equipmentType])
  @@index([rarity])
  @@index([status])
  @@map("equipment_instance")
}

model EquipmentAffix {
  affixId             String   @id @map("affix_id")
  equipmentInstanceId String   @map("equipment_instance_id")
  affixType           String   @map("affix_type")
  affixKey            String   @map("affix_key")
  name                String
  value               Int
  locked              Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  equipment EquipmentInstance @relation(fields: [equipmentInstanceId], references: [equipmentInstanceId], onDelete: Cascade)

  @@index([equipmentInstanceId])
  @@index([affixType])
  @@index([affixKey])
  @@map("equipment_affix")
}

model EquipmentOperationRecord {
  recordId            String   @id @map("record_id")
  playerId            String   @map("player_id")
  eraId               String   @default("era_mvp_001") @map("era_id")
  equipmentInstanceId String?  @map("equipment_instance_id")
  operationType       String   @map("operation_type")
  materialSnapshot    Json     @map("material_snapshot")
  resultSnapshot      Json     @map("result_snapshot")
  configVersion       String   @map("config_version")
  idempotencyKey      String?  @unique @map("idempotency_key")
  createdAt           DateTime @default(now()) @map("created_at")

  player    Player             @relation(fields: [playerId], references: [playerId])
  equipment EquipmentInstance? @relation(fields: [equipmentInstanceId], references: [equipmentInstanceId], onDelete: SetNull)

  @@index([playerId])
  @@index([eraId])
  @@index([equipmentInstanceId])
  @@index([operationType])
  @@index([createdAt])
  @@map("equipment_operation_record")
}

model PlayerSkillLoadout {
  playerId        String   @id @map("player_id")
  activeSkillIds  Json     @map("active_skill_ids")
  treasureSkillId String   @map("treasure_skill_id")
  autoPriority    Json     @map("auto_priority")
  updatedAt       DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@map("player_skill_loadout")
}

model TowerState {
  towerStateId   String   @id @map("tower_state_id")
  eraId          String   @default("era_mvp_001") @map("era_id")
  provinceId     String   @map("province_id")
  towerId        String   @map("tower_id")
  towerName      String   @map("tower_name")
  integrity      Int      @default(1000)
  sealProgress   Int      @default(0) @map("seal_progress")
  breakProgress  Int      @default(0) @map("break_progress")
  supplyProgress Int      @default(0) @map("supply_progress")
  riftPressure   Int      @default(0) @map("rift_pressure")
  corruption     Int      @default(0)
  phase          Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at")

  actions TowerActionRecord[]

  @@unique([eraId, towerId])
  @@index([eraId])
  @@index([provinceId])
  @@map("tower_state")
}

model TowerActionRecord {
  recordId         String   @id @map("record_id")
  playerId         String   @map("player_id")
  sectId           String?  @map("sect_id")
  eraId            String   @default("era_mvp_001") @map("era_id")
  towerId          String   @map("tower_id")
  actionType       String   @map("action_type")
  count            Int
  contribution     Int
  actionPointCost  Int      @map("action_point_cost")
  rewardSnapshot   Json     @map("reward_snapshot")
  settlementStatus String   @default("settled") @map("settlement_status")
  configVersion    String   @map("config_version")
  idempotencyKey   String?  @unique @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")

  player Player     @relation(fields: [playerId], references: [playerId])
  tower  TowerState @relation(fields: [eraId, towerId], references: [eraId, towerId])
  sect   Sect?      @relation(fields: [sectId], references: [sectId])

  @@index([playerId])
  @@index([sectId])
  @@index([eraId, towerId])
  @@index([actionType])
  @@index([createdAt])
  @@map("tower_action_record")
}

model WorldBossState {
  bossStateId   String   @id @map("boss_state_id")
  eraId         String   @default("era_mvp_001") @map("era_id")
  bossId        String   @map("boss_id")
  name          String
  phase         Int      @default(1)
  totalHp       Int      @map("total_hp")
  remainingHp   Int      @map("remaining_hp")
  defeatedCount Int      @default(0) @map("defeated_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  challenges WorldBossChallengeRecord[]

  @@unique([eraId, bossId])
  @@index([eraId])
  @@map("world_boss_state")
}

model WorldBossChallengeRecord {
  recordId       String   @id @map("record_id")
  playerId       String   @map("player_id")
  sectId         String?  @map("sect_id")
  eraId          String   @default("era_mvp_001") @map("era_id")
  bossId         String   @map("boss_id")
  damageDone     Int      @map("damage_done")
  contribution   Int
  result         String
  rewardSnapshot Json     @map("reward_snapshot")
  battleLog      Json     @map("battle_log")
  configVersion  String   @map("config_version")
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  player Player         @relation(fields: [playerId], references: [playerId])
  boss   WorldBossState @relation(fields: [eraId, bossId], references: [eraId, bossId])
  sect   Sect?          @relation(fields: [sectId], references: [sectId])

  @@index([playerId])
  @@index([sectId])
  @@index([eraId, bossId])
