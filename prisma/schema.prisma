generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  accountId    String    @id @map("account_id")
  accountType  String    @map("account_type")
  deviceId     String?   @unique @map("device_id")
  fishpiUserId String?   @unique @map("fishpi_user_id")
  username     String?
  status       String    @default("normal")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  player       Player?
  auditLogs    AuditLog[]
  loginLogs    LoginLog[]
  behaviorLogs BehaviorLog[]
  riskRecords  BehaviorRiskRecord[]
  idempotency  IdempotencyRecord[]
  transferRequests TransferRequestRecord[]

  @@index([accountType])
  @@index([status])
  @@map("account")
}

model Player {
  playerId     String   @id @map("player_id")
  accountId    String   @unique @map("account_id")
  name         String   @unique
  route        String
  alignment    String   @default("undecided")
  currentRealm Int      @default(1) @map("current_realm")
  currentStage Int      @default(1) @map("current_stage")
  currentLevel Int      @default(1) @map("current_level")
  sectId       String?  @map("sect_id")
  status       String   @default("normal")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account                   Account                    @relation(fields: [accountId], references: [accountId])
  progress                  PlayerProgress?
  wallet                    PlayerWallet?
  actionState               PlayerActionState?
  caveState                 PlayerCaveState?
  innerWorldState           InnerWorldState?
  innerWorldCreatures       InnerWorldCreature[]
  innerWorldAssignments     InnerWorldAssignment[]
  innerWorldLawRecords      InnerWorldLawRecord[]
  innerWorldSupportRecords  InnerWorldSupportRecord[]
  factionState              PlayerFactionState?
  factionTransferRecords    FactionTransferRecord[]
  items                     PlayerItem[]
  walletLogs                WalletLog[]
  auditLogs                 AuditLog[]
  behaviorLogs              BehaviorLog[]
  loginLogs                 LoginLog[]
  provinces                 PlayerProvinceProgress[]
  tasks                     PlayerTaskState[]
  eventRecords              EventRecord[]
  eventRewardRecords        EventRewardRecord[]
  battleLogs                BattleLog[]
  exploreActionRecords      ExploreActionRecord[]
  exploreEventRecords       ExploreEventRecord[]
  journalEntries            PlayerJournalEntry[]
  caveRecords               CaveCollectRecord[]
  alchemyRecords            AlchemyRecord[]
  pillUseRecords            PillUseRecord[]
  equipmentInstances        EquipmentInstance[]
  equipmentOperationRecords EquipmentOperationRecord[]
  skillLoadout              PlayerSkillLoadout?
  skillRecords              PlayerSkillRecord[]
  sectMembership            SectMember?
  towerActionRecords        TowerActionRecord[]
  bossChallengeRecords      WorldBossChallengeRecord[]
  pvpAttacks                PvpBattleRecord[]          @relation("PvpAttacker")
  pvpDefenses               PvpBattleRecord[]          @relation("PvpDefender")
  sectTaskRecords           SectTaskRecord[]
  purchaseOrders            PurchaseOrder[]
  monthlyCards              MonthlyCardState[]
  monthlyDrawGrants         MonthlyCardDrawGrant[]
  vipState                  PlayerVipState?
  gachaRecords              GachaRecord[]
  gachaPityStates           GachaPityState[]
  ancientTreasures          AncientTreasureState[]
  convenienceStrategies     ConvenienceStrategy[]
  automationQueues          AutomationQueue[]
  appearances               PlayerAppearance[]
  appearanceOwnerships      AppearanceOwnershipRecord[]
  riskRecords               BehaviorRiskRecord[]
  delayedSettlements        DelayedSettlementRecord[]
  mails                     PlayerMail[]
  storyScrollRecords        StoryScrollRecord[]
  eraCollections            EraCollectionRecord[]
  mentorRelationsAsMentor   MentorRelationRecord[]    @relation("MentorRelationMentor")
  mentorRelationsAsApprentice MentorRelationRecord[]  @relation("MentorRelationApprentice")
  hireHelpRecords           SectHireRecord[]
  transferRequests          TransferRequestRecord[]
  cities                    PlayerCity[]
  herbGardenPlots           CityHerbGardenPlot[]
  marchQueues               MarchQueue[]
  worldBlockClearances      WorldBlockClearance[]
  worldBlockOwnerships      WorldBlockOwnership[]
  territoryGarrisons        TerritoryGarrison[]
  armyPresets               CityArmyPreset[]

  @@index([accountId])
  @@index([sectId])
  @@index([currentRealm, currentStage, currentLevel])
  @@index([status])
  @@map("player")
}

model PlayerCity {
  cityId           String    @id @map("city_id")
  playerId         String    @map("player_id")
  eraId            String    @default("era_mvp_001") @map("era_id")
  cityType         String    @map("city_type")
  provinceId       String    @map("province_id")
  commanderyId     String    @map("commandery_id")
  tileId           String    @unique @map("tile_id")
  cityName         String    @map("city_name")
  cityLevel        Int       @default(1) @map("city_level")
  status           String    @default("protected")
  protectionUntil  DateTime? @map("protection_until")
  ownerSectId      String?   @map("owner_sect_id")
  defenseSnapshot  Json      @map("defense_snapshot")
  resourceSnapshot Json      @map("resource_snapshot")
  territoryCollectedAt DateTime @default(now()) @map("territory_collected_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])
  marchQueues MarchQueue[]
  buildings CityBuilding[]
  herbGardenPlots CityHerbGardenPlot[]
  armyPresets CityArmyPreset[]

  @@index([playerId])
  @@index([eraId])
  @@index([cityType])
  @@index([provinceId])
  @@index([commanderyId])
  @@index([status])
  @@index([protectionUntil])
  @@map("player_city")
}

model SiegeRecord {
  siegeId           String    @id @map("siege_id")
  eraId             String    @default("era_mvp_001") @map("era_id")
  targetCityId      String    @map("target_city_id")
  targetTileId      String    @map("target_tile_id")
  marchId           String    @map("march_id")
  attackerPlayerId  String    @map("attacker_player_id")
  defenderPlayerId  String    @map("defender_player_id")
  status             String
  attackerPower      Int       @map("attacker_power")
  defenderPower      Int       @map("defender_power")
  wallDamage         Int       @default(0) @map("wall_damage")
  plunderSnapshot    Json      @map("plunder_snapshot")
  cityStateBefore    Json      @map("city_state_before")
  cityStateAfter     Json      @map("city_state_after")
  rewardRatePercent  Int       @default(100) @map("reward_rate_percent")
  protectionUntil    DateTime? @map("protection_until")
  idempotencyKey     String    @unique @map("idempotency_key")
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime  @default(now()) @map("resolved_at")

  @@index([targetCityId, createdAt])
  @@index([attackerPlayerId, targetCityId, createdAt])
  @@index([defenderPlayerId, createdAt])
  @@index([status])
  @@map("siege_record")
}

model StrategicControlRecord {
  controlId          String    @id @map("control_id")
  eraId              String    @default("era_mvp_001") @map("era_id")
  landmarkGroupId    String    @map("landmark_group_id")
  tileId             String    @map("tile_id")
  provinceId         String    @map("province_id")
  controlType        String    @map("control_type")
  controllerType     String    @map("controller_type")
  controllerId       String    @map("controller_id")
  controllerName     String    @map("controller_name")
  attackerPower      Int       @map("attacker_power")
  defenderPower      Int       @map("defender_power")
  status             String
  startsAt           DateTime  @map("starts_at")
  expiresAt           DateTime  @map("expires_at")
  sourceMarchId       String    @map("source_march_id")
  idempotencyKey      String    @unique @map("idempotency_key")
  createdAt           DateTime  @default(now()) @map("created_at")
  resolvedAt          DateTime  @default(now()) @map("resolved_at")

  @@index([eraId, landmarkGroupId, status, expiresAt])
  @@index([provinceId, controlType, status])
  @@index([controllerId, status, expiresAt])
  @@map("strategic_control_record")
}

model SectRally {
  rallyId           String    @id @map("rally_id")
  eraId             String    @default("era_mvp_001") @map("era_id")
  sectId            String    @map("sect_id")
  targetTileId      String    @map("target_tile_id")
  landmarkGroupId   String    @map("landmark_group_id")
  provinceId        String    @map("province_id")
  rallyType         String    @map("rally_type")
  status            String    @default("open")
  createdByPlayerId String    @map("created_by_player_id")
  startsAt          DateTime  @default(now()) @map("starts_at")
  endsAt            DateTime  @map("ends_at")
  resolvedAt        DateTime? @map("resolved_at")
  resultSnapshot    Json      @default("{}") @map("result_snapshot")
  idempotencyKey    String    @unique @map("idempotency_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([sectId, status, endsAt])
  @@index([landmarkGroupId, status, endsAt])
  @@map("sect_rally")
}

model SectRallyMember {
  rallyMemberId String   @id @map("rally_member_id")
  rallyId       String   @map("rally_id")
  playerId      String   @map("player_id")
  teamPower     Int      @map("team_power")
  joinedAt      DateTime @default(now()) @map("joined_at")

  @@unique([rallyId, playerId])
  @@index([rallyId])
  @@index([playerId])
  @@map("sect_rally_member")
}

model CityBuilding {
  buildingId       String    @id @map("building_id")
  cityId           String    @map("city_id")
  buildingType     String    @map("building_type")
  level            Int       @default(1)
  status           String    @default("idle")
  targetLevel      Int?      @map("target_level")
  upgradeStartedAt DateTime? @map("upgrade_started_at")
  upgradeEndsAt    DateTime? @map("upgrade_ends_at")
  costSnapshot     Json      @map("cost_snapshot")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  city PlayerCity @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@unique([cityId, buildingType])
  @@index([cityId])
  @@index([status])
  @@index([upgradeEndsAt])
  @@map("city_building")
}

model CityHerbGardenPlot {
  plotId     String    @id @map("plot_id")
  playerId   String    @map("player_id")
  cityId     String    @map("city_id")
  plotIndex  Int       @map("plot_index")
  herbId     String?   @map("herb_id")
  status     String    @default("empty")
  plantedAt  DateTime? @map("planted_at")
  readyAt    DateTime? @map("ready_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  player Player     @relation(fields: [playerId], references: [playerId])
  city   PlayerCity @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@unique([cityId, plotIndex])
  @@index([playerId, cityId])
  @@index([readyAt])
  @@map("city_herb_garden_plot")
}

model MarchQueue {
  marchId        String   @id @map("march_id")
  playerId       String   @map("player_id")
  eraId          String   @default("era_mvp_001") @map("era_id")
  sourceCityId   String   @map("source_city_id")
  sourceTileId   String   @map("source_tile_id")
  targetTileId   String   @map("target_tile_id")
  targetName     String   @map("target_name")
  provinceId     String   @map("province_id")
  commanderyId   String   @map("commandery_id")
  marchType      String   @map("march_type")
  status         String   @default("marching")
  teamSnapshot   Json     @map("team_snapshot")
  travelSeconds  Int      @map("travel_seconds")
  startedAt      DateTime @default(now()) @map("started_at")
  arrivesAt      DateTime @map("arrives_at")
  resolvedAt     DateTime? @map("resolved_at")
  idempotencyKey String?  @unique @map("idempotency_key")
  configVersion  String   @map("config_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  player     Player     @relation(fields: [playerId], references: [playerId])
  sourceCity PlayerCity @relation(fields: [sourceCityId], references: [cityId])
  clearance  WorldBlockClearance?

  @@index([playerId])
  @@index([eraId])
  @@index([provinceId, commanderyId])
  @@index([sourceCityId])
  @@index([targetTileId])
  @@index([status])
  @@index([arrivesAt])
  @@index([createdAt])
  @@map("march_queue")
}

model WorldBlockClearance {
  clearanceId    String   @id @map("clearance_id")
  playerId       String   @map("player_id")
  eraId          String   @default("era_mvp_001") @map("era_id")
  sourceMarchId  String   @unique @map("source_march_id")
  tileId         String   @map("tile_id")
  provinceId     String   @map("province_id")
  commanderyId   String   @map("commandery_id")
  status         String
  teamPower      Int      @map("team_power")
  enemyPower     Int      @map("enemy_power")
  battleId       String   @map("battle_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  configVersion  String   @map("config_version")
  resolvedAt     DateTime @default(now()) @map("resolved_at")
  createdAt      DateTime @default(now()) @map("created_at")

  player      Player     @relation(fields: [playerId], references: [playerId])
  sourceMarch MarchQueue @relation(fields: [sourceMarchId], references: [marchId])

  @@index([playerId, tileId, status])
  @@index([eraId, tileId, status])
  @@index([provinceId, commanderyId])
  @@index([resolvedAt])
  @@map("world_block_clearance")
}

model WorldBlockOwnership {
  ownershipId      String   @id @map("ownership_id")
  playerId         String   @map("player_id")
  eraId            String   @default("era_mvp_001") @map("era_id")
  tileId           String   @map("tile_id")
  provinceId       String   @map("province_id")
  commanderyId     String   @map("commandery_id")
  terrainType      String   @map("terrain_type")
  ownershipType    String   @map("ownership_type")
  status           String   @default("owned")
  sourceType       String   @map("source_type")
  sourceId         String?  @map("source_id")
  purchaseCost     BigInt   @default(0) @map("purchase_cost")
  idempotencyKey   String?  @unique @map("idempotency_key")
  configVersion    String   @map("config_version")
  ownedAt          DateTime @default(now()) @map("owned_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@unique([eraId, tileId])
  @@index([playerId])
  @@index([eraId])
  @@index([provinceId, commanderyId])
  @@index([terrainType])
  @@index([ownershipType])
  @@index([status])
  @@index([ownedAt])
  @@map("world_block_ownership")
}

model TerritoryGarrison {
  garrisonId      String   @id @map("garrison_id")
  playerId        String   @map("player_id")
  eraId           String   @default("era_mvp_001") @map("era_id")
  tileId          String   @map("tile_id")
  sourceCityId    String   @map("source_city_id")
  soldierCount    Int      @map("soldier_count")
  defensePower    Int      @map("defense_power")
  presetSnapshot  Json     @default("{}") @map("preset_snapshot")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@unique([eraId, tileId])
  @@index([playerId])
  @@index([sourceCityId])
  @@map("territory_garrison")
}

model CityArmyPreset {
  presetId      String   @id @map("preset_id")
  playerId      String   @map("player_id")
  cityId        String   @map("city_id")
  presetType    String   @map("preset_type")
  presetName    String   @map("preset_name")
  commanderId   String   @map("commander_id")
  soldierCount  Int      @map("soldier_count")
  formation     String
  power         Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  player Player     @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  city   PlayerCity @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@unique([playerId, presetType])
  @@index([cityId])
  @@index([playerId])
  @@map("city_army_preset")
}

model PlayerProgress {
  playerId               String    @id @map("player_id")
  eraId                  String    @default("era_mvp_001") @map("era_id")
  cultivationValue       BigInt    @default(0) @map("cultivation_value")
  breakthroughFailCount  Int       @default(0) @map("breakthrough_fail_count")
  calamityValue          Int       @default(0) @map("calamity_value")
  chapterId              Int       @default(1) @map("chapter_id")
  catchupBonusRate       Int       @default(0) @map("catchup_bonus_rate")
  newbieProtectionUntil  DateTime? @map("newbie_protection_until")
  dailyActiveScore       Int       @default(0) @map("daily_active_score")
  weeklyActiveScore      Int       @default(0) @map("weekly_active_score")
  cultivationRatePerHour Int       @default(240) @map("cultivation_rate_per_hour")
  lastCultivationAt      DateTime  @default(now()) @map("last_cultivation_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([eraId])
  @@index([chapterId])
  @@map("player_progress")
}

model PlayerWallet {
  playerId      String   @id @map("player_id")
  spiritStone   BigInt   @default(0) @map("spirit_stone")
  immortalStone BigInt   @default(0) @map("immortal_stone")
  jadePaid      BigInt   @default(0) @map("jade_paid")
  jadeBound     BigInt   @default(0) @map("jade_bound")
  eraPoint      BigInt   @default(0) @map("era_point")
  updatedAt     DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@map("player_wallet")
}

model PlayerItem {
  itemInstanceId String    @id @map("item_instance_id")
  playerId       String    @map("player_id")
  itemId         String    @map("item_id")
  count          BigInt
  bindType       String    @map("bind_type")
  locked         Boolean   @default(false)
  sourceType     String    @map("source_type")
  metadata       Json?
  expireAt       DateTime? @map("expire_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([itemId])
  @@index([bindType])
  @@index([sourceType])
  @@index([expireAt])
  @@map("player_item")
}

model PlayerActionState {
  playerId                  String   @id @map("player_id")
  eraId                     String   @default("era_mvp_001") @map("era_id")
  actionPoints              Int      @default(60) @map("action_points")
  actionPointCap            Int      @default(180) @map("action_point_cap")
  actionPointRestorePerHour Int      @default(12) @map("action_point_restore_per_hour")
  lastRecoveredAt           DateTime @default(now()) @map("last_recovered_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([eraId])
  @@map("player_action_state")
}

model ProvinceState {
  provinceStateId String   @id @map("province_state_id")
  eraId           String   @default("era_mvp_001") @map("era_id")
  provinceId      String   @map("province_id")
  name            String
  towerName       String   @map("tower_name")
  chapterRequired Int      @default(1) @map("chapter_required")
  unlocked        Boolean  @default(true)
  towerIntegrity  Int      @default(1000) @map("tower_integrity")
  riftPressure    Int      @default(0) @map("rift_pressure")
  corruption      Int      @default(0)
  spiritVeinLevel Int      @default(1) @map("spirit_vein_level")
  factionControl  Json     @map("faction_control")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([eraId, provinceId])
  @@index([eraId])
  @@index([provinceId])
  @@map("province_state")
}

model PlayerProvinceProgress {
  provinceProgressId String    @id @map("province_progress_id")
  playerId           String    @map("player_id")
  eraId              String    @default("era_mvp_001") @map("era_id")
  provinceId         String    @map("province_id")
  unlocked           Boolean   @default(false)
  bestExploreStage   Int       @default(0) @map("best_explore_stage")
  explorationCount   Int       @default(0) @map("exploration_count")
  lastActionAt       DateTime? @map("last_action_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@unique([playerId, provinceId])
  @@index([playerId])
  @@index([eraId, provinceId])
  @@map("player_province_progress")
}

model BattleLog {
  battleId       String   @id @map("battle_id")
  playerId       String   @map("player_id")
  eraId          String   @default("era_mvp_001") @map("era_id")
  battleType     String   @map("battle_type")
  provinceId     String?  @map("province_id")
  enemyId        String   @map("enemy_id")
  enemyName      String   @map("enemy_name")
  result         String
  rounds         Int
  damageDone     Int      @map("damage_done")
  damageTaken    Int      @map("damage_taken")
  rewardSnapshot Json     @map("reward_snapshot")
  battleLog      Json     @map("battle_log")
  createdAt      DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [playerId])

  @@index([playerId])
  @@index([eraId])
  @@index([battleType])
  @@index([provinceId])
  @@index([createdAt])
  @@map("battle_log")
}

model ExploreActionRecord {
  recordId            String    @id @map("record_id")
  playerId            String    @map("player_id")
  eraId               String    @default("era_mvp_001") @map("era_id")
  provinceId          String    @map("province_id")
  provinceName        String    @map("province_name")
  count               Int
  secondsPerExplore   Int       @map("seconds_per_explore")
  totalSeconds        Int       @map("total_seconds")
  status              String    @default("pending")
  startedAt           DateTime  @default(now()) @map("started_at")
  completesAt         DateTime  @map("completes_at")
  claimedAt           DateTime? @map("claimed_at")
  rewardSnapshot      Json?     @map("reward_snapshot")
  battleSnapshot      Json?     @map("battle_snapshot")
  experienceSnapshot  Json?     @map("experience_snapshot")
  completedTaskIds    Json?     @map("completed_task_ids")
  actionStateSnapshot Json?     @map("action_state_snapshot")
  idempotencyKey      String    @unique @map("idempotency_key")
  configVersion       String    @default("m2_core_loop_v2") @map("config_version")
  rulesetVersion      String    @default("ruleset_p1_6_v1") @map("ruleset_version")
  rewardConfigVersion String    @default("reward_p1_6_v1") @map("reward_config_version")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  player      Player              @relation(fields: [playerId], references: [playerId])
  eventRecord ExploreEventRecord?

  @@index([playerId])
  @@index([eraId, provinceId])
  @@index([status])
  @@index([completesAt])
  @@index([createdAt])
  @@map("explore_action_record")
}

model ExploreEventRecord {
  eventId             String    @id @map("event_id")
  playerId            String    @map("player_id")
  eraId               String    @default("era_mvp_001") @map("era_id")
  exploreRecordId     String    @unique @map("explore_record_id")
  provinceId          String    @map("province_id")
  provinceName        String    @map("province_name")
  eventType           String    @map("event_type")
  title               String
  description         String
  choices             Json
  status              String    @default("pending")
  selectedChoiceId    String?   @map("selected_choice_id")
  rewardSnapshot      Json?     @map("reward_snapshot")
  experienceSnapshot  Json?     @map("experience_snapshot")
  resolvedIdempotency String?   @unique @map("resolved_idempotency_key")
  configVersion       String    @default("p1_7_explore_event_v1") @map("config_version")
