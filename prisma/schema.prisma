  account Account @relation(fields: [accountId], references: [accountId])
  player  Player? @relation(fields: [playerId], references: [playerId])

  @@index([accountId])
  @@index([playerId])
  @@index([loginType])
  @@index([createdAt])
  @@map("login_log")
}

model BehaviorLog {
  behaviorLogId  String   @id @map("behavior_log_id")
  requestId      String   @map("request_id")
  accountId      String?  @map("account_id")
  playerId       String?  @map("player_id")
  method         String
  path           String
  statusCode     Int      @map("status_code")
  durationMs     Int      @map("duration_ms")
  idempotencyKey String?  @map("idempotency_key")
  clientVersion  String?  @map("client_version")
  ipHash         String?  @map("ip_hash")
  userAgentHash  String?  @map("user_agent_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  account Account? @relation(fields: [accountId], references: [accountId])
  player  Player?  @relation(fields: [playerId], references: [playerId])

  @@index([requestId])
  @@index([accountId])
  @@index([playerId])
  @@index([method, path])
  @@index([statusCode])
  @@index([createdAt])
  @@map("behavior_log")
}

model IdempotencyRecord {
  idempotencyKey String   @id @map("idempotency_key")
  accountId      String?  @map("account_id")
  endpoint       String
  requestHash    String   @map("request_hash")
  responseData   Json     @map("response_data")
  statusCode     Int      @default(200) @map("status_code")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  account Account? @relation(fields: [accountId], references: [accountId])

  @@index([accountId])
  @@index([endpoint])
  @@index([expiresAt])
  @@map("idempotency_record")
}
